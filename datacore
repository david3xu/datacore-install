#!/bin/sh
# Datacore front door — wraps the bundle scripts installed under ~/.datacore/current.
#
# Usage:  datacore <verb> [args...]
#
# Environment overrides:
#   DATACORE_INSTALL_ROOT   where versions are kept (default: ~/.datacore)

set -eu

# The installer places this script at <install root>/bin/datacore, so our own location is the
# install we belong to. Trust it over a guess at $HOME: an install with a custom
# DATACORE_INSTALL_ROOT must keep working without the user exporting anything.
_SELF_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || _SELF_DIR=""
if [ -n "${DATACORE_INSTALL_ROOT:-}" ]; then
  ROOT="$DATACORE_INSTALL_ROOT"
elif [ -n "$_SELF_DIR" ] && { [ -d "$_SELF_DIR/../versions" ] || [ -e "$_SELF_DIR/../current" ]; }; then
  # `versions/` is what this installer creates, but an install made before it exists keeps its
  # bundles directly under the root with the same `current` pointer. Accepting either means the
  # command works when dropped into such an install's bin/ without exporting anything.
  ROOT=$(cd "$_SELF_DIR/.." && pwd)
else
  ROOT="$HOME/.datacore"
fi
C="$ROOT/current"

# Every lib script resolves its own paths from this, so export the root we just resolved rather
# than letting each one fall back to ~/.datacore. Without this, `datacore uninstall` run from an
# install in a non-default location would target the default location instead.
DATACORE_INSTALL_ROOT="$ROOT"; export DATACORE_INSTALL_ROOT

# `datacore update` re-runs the installer, which is what knows how to fetch the latest release and
# hand the previous install to the new bundle's upgrade step. Overridable for a private mirror.
INSTALLER_URL="${DATACORE_INSTALLER_URL:-https://raw.githubusercontent.com/david3xu/datacore-install/main/install.sh}"

# The bundle scripts exec `bun`. On a machine without it the installer put a private copy next to
# this script, so put our own directory on PATH rather than making the user edit their shell rc.
if [ -n "$_SELF_DIR" ]; then
  PATH="$_SELF_DIR:$PATH"
  export PATH
fi

# ---------------------------------------------------------------- helpers

die() { printf '%s\n' "$1" >&2; [ $# -gt 1 ] && printf '%s\n' "$2" >&2; exit 1; }

not_yet() {
  printf 'datacore %s: not available yet. %s\n' "$1" "$2" >&2
  exit 2
}

run_lib_script() {
  # Locate the lib/ directory relative to this script, then exec the named file. Capture the name
  # before shifting it away, or the "not found" message reports the first argument instead.
  _name=$1; shift
  _self=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || _self=""
  _lib="${_self}/lib/$_name"
  [ -f "$_lib" ] || die "lib/$_name is not installed alongside the datacore command." \
    "The release this was installed from may not carry it yet. Re-run the installer to pick it up."
  exec sh "$_lib" "$@"
}

run_installer() {
  command -v curl >/dev/null 2>&1 || die "curl is needed to fetch the installer."
  [ $# -eq 0 ] || die "datacore update takes no arguments."
  DATACORE_INSTALL_ROOT="$ROOT"; export DATACORE_INSTALL_ROOT
  printf 'Fetching the installer from %s\n\n' "$INSTALLER_URL"
  _tmp=$(mktemp) || die "Could not create a temporary file."
  curl -fsSL --retry 3 -o "$_tmp" "$INSTALLER_URL" || { rm -f "$_tmp"; die "Could not download the installer from $INSTALLER_URL"; }
  sh "$_tmp"; _status=$?
  rm -f "$_tmp"
  exit $_status
}

run_bundle_script() {
  verb="$1"; script="$2"; shift 2
  [ -d "$C" ] || die "Datacore is not installed. Run the installer: https://github.com/david3xu/datacore-install"
  if [ ! -f "$C/$script" ]; then
    # $C is the 'current' symlink; resolve it so the message names the real version.
    ver=$(basename "$(cd "$C" 2>/dev/null && pwd -P || printf '%s' "$C")")
    die "$script is missing from $ver. Re-run the installer, or upgrade: datacore update"
  fi
  exec "$C/$script" "$@"
}

# ---------------------------------------------------------------- usage

usage() {
  cat <<'EOF'
Usage: datacore <verb> [args...]

Running the stack:
  status      show running state and enabled features
  start       start the Datacore stack
  stop        stop the Datacore stack
  logs        tail component logs (pass -f to follow)

Diagnosing:
  doctor      diagnose problems, with remediation steps

Data:
  backup      back up the Datacore data directory
  restore     restore from a backup

Lifecycle:
  update      fetch the latest release and upgrade in place, rolling back on failure
  uninstall   remove containers, AI client entries, the login agent and the install
              (--purge-data also deletes your data, --purge-images the loaded images)

Providers:
  provider    configure a model API key (add/list/remove)

Workers:
  worker      register a local AI CLI or API provider as a worker (add/list/remove)

Not yet available:
  connect     register Datacore with an AI client (the installer does this for you)
  enable      turn on optional feature profiles
EOF
  exit 0
}

# ---------------------------------------------------------------- dispatch

verb="${1:-}"
[ $# -gt 0 ] && shift

case "$verb" in
  ''|-h|--help) usage ;;

  status)    run_bundle_script status    status-datacore-local.sh    "$@" ;;
  doctor)    run_bundle_script doctor    doctor.sh                   "$@" ;;
  logs)      run_bundle_script logs      tail-datacore-local.sh      "$@" ;;
  start)     run_bundle_script start     start-datacore-local.sh     "$@" ;;
  stop)      run_bundle_script stop      stop-datacore-local.sh      "$@" ;;
  backup)    run_bundle_script backup    backup-datacore-local.sh    "$@" ;;
  restore)   run_bundle_script restore   restore-datacore-local.sh   "$@" ;;
  update)    run_installer "$@" ;;
  uninstall) run_lib_script uninstall.sh "$@" ;;

  connect)  not_yet connect "Re-run the installer; it registers every AI client it finds." ;;
  enable)   not_yet enable  "Workers are turned on with: datacore worker add" ;;
  provider) run_lib_script provider.sh "$@" ;;
  worker)   run_lib_script worker.sh   "$@" ;;

  *) printf 'Unknown command: %s\n' "$verb" >&2; exit 2 ;;
esac
